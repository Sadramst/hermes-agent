# Local Windows / Docker development configuration for Hermes Agent (Sadramst)
# Copy this file to .env.local and paste your OpenRouter API key.

HERMES_ENV=dev
HERMES_HOST=127.0.0.1
HERMES_PORT=8080
HERMES_LOG_LEVEL=INFO
HERMES_MEMORY_DIR=storage/memory
HERMES_SKILLS_DIR=storage/skills

# ChromaDB connection (localhost for native Windows, chromadb inside Docker)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=

# Optional bearer token for HTTP routes and /mcp
HERMES_API_TOKEN=

# OpenRouter LLM defaults (set HERMES_MODEL_API_KEY in .env.local to enable completions)
HERMES_MODEL_BASE_URL=https://openrouter.ai/api/v1
HERMES_MODEL_NAME=google/gemini-2.5-flash
HERMES_MODEL_SMALL=google/gemini-2.5-flash-lite
HERMES_MODEL_API_KEY=

# OpenRouter Embeddings for semantic RAG & memory search (optional; uses hash vectors when unset)
HERMES_EMBED_BASE_URL=
HERMES_EMBED_MODEL=
HERMES_EMBED_API_KEY=
HERMES_EMBED_INPUT_TYPE=off
HERMES_RAG_MODE=off
HERMES_MEMORY_INDEX=off

# MCP Server (/mcp) and optional gates (all off by default)
HERMES_MCP_ENABLED=off
HERMES_MCP_ALLOWED_HOSTS=
HERMES_JEV_MODE=off
HERMES_GROK_HANDOFF=off
