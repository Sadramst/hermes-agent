# Local Windows / Docker development configuration for Hermes Agent
# Copy this file to .env.local and add your OpenRouter or Google AI Studio API key.

HERMES_ENV=dev
HERMES_HOST=127.0.0.1
HERMES_PORT=8080
HERMES_LOG_LEVEL=INFO
HERMES_MEMORY_DIR=storage/memory
HERMES_SKILLS_DIR=storage/skills
HERMES_PROFILE_DIR=gateway
# Set your timezone (e.g. UTC, Asia/Singapore, Europe/London, America/New_York, UTC+08:00)
HERMES_TIMEZONE=UTC

# ChromaDB connection (localhost for native Windows/Linux, chromadb inside Docker)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=

# Optional bearer token for HTTP routes and /mcp (required when HERMES_MCP_ENABLED=on)
HERMES_API_TOKEN=

# Model provider (OpenRouter default; or Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai)
# Official Google-approved Gemini Subscription OAuth is pending Nous + Google release (not live yet).
HERMES_PROVIDER_AUTH_MODE=openrouter
HERMES_MODEL_BASE_URL=https://openrouter.ai/api/v1
HERMES_MODEL_NAME=google/gemini-2.5-flash
HERMES_MODEL_API_KEY=

# OpenRouter Embeddings for semantic RAG & memory search (optional; uses hash vectors when unset)
HERMES_EMBED_BASE_URL=
HERMES_EMBED_MODEL=
HERMES_EMBED_API_KEY=
HERMES_EMBED_INPUT_TYPE=off
HERMES_RAG_MODE=off
HERMES_MEMORY_INDEX=off

# MCP Server (/mcp) for Telegram gateway and Antigravity / Cursor IDE clients
HERMES_MCP_ENABLED=off
HERMES_MCP_ALLOWED_HOSTS=

# Optional sandboxed project workspace access (off | ro | rw)
# HERMES_WORKSPACE_MODE=off
# HERMES_PROJECTS_DIR=
# HERMES_WORKSPACE_ALLOWED_CMDS=
