# Example everyday scheduled routines for Telegram (hermes-gateway).
# Create or adjust schedules via `hermes cron` inside `hermes-gateway` (or directly in chat).
# Schedules run in the container timezone set by HERMES_TIMEZONE (`TZ`).

routines:
  - name: morning-briefing
    schedule: "0 8 * * 1-5"
    channel: telegram
    prompt: >
      Good morning check-in. Call `hermes-api` `current_time`, check `list_memories` for `goal.`
      and `work.` keys, and send a concise morning plan: today's date, top 3 priorities,
      and one focus reminder.

  - name: evening-consolidation
    schedule: "30 21 * * *"
    channel: telegram
    prompt: >
      Evening wrap-up. Ask briefly what went well today, any decisions, spending/budget notes, or
      learnings worth saving to `hermes-api` (`remember` / `save_document`), and suggest
      tomorrow's top priority.

  - name: weekly-review
    schedule: "0 10 * * 0"
    channel: telegram
    prompt: >
      Sunday weekly review. Inspect `goal.`, `habit.`, and `finance.` keys in `hermes-api`
      (`list_memories` + `recall`). Summarize progress, highlight any budget/runway numbers to
      refresh, and propose next week's top priorities.

  - name: weekly-minipc-maintenance
    schedule: "0 9 * * 1"
    channel: telegram
    prompt: >
      Check `ops.` memory keys in `hermes-api`. Remind the user to verify Mini PC `/health`
      (`workspace`, `chroma`, `assistant`), run `bash docker/scripts/sync-brain.sh`, check recent
      `backups/` snapshots (`backup-brain.sh`), inspect disk space (`cleanup-disk.sh --dry-run`),
      and check if Nous Research shipped official Google-approved Gemini Subscription OAuth.
