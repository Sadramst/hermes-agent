# Production settings template for Ubuntu VPS (Sadramst/hermes-agent).
# Copy to docker/env/.env.prod on your server and fill in secrets with `openssl rand -hex 32`.

HERMES_ENV=prod
HERMES_HOST=0.0.0.0
HERMES_PORT=8080
HERMES_LOG_LEVEL=INFO
HERMES_MEMORY_DIR=/app/storage/memory
HERMES_SKILLS_DIR=/app/storage/skills

CHROMA_HOST=chroma-gate
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=replace-with-openssl-rand-hex-32
HERMES_API_TOKEN=replace-with-second-openssl-rand-hex-32

# OpenRouter LLM Provider
HERMES_MODEL_BASE_URL=https://openrouter.ai/api/v1
HERMES_MODEL_NAME=google/gemini-2.5-flash
HERMES_MODEL_SMALL=google/gemini-2.5-flash-lite
HERMES_MODEL_API_KEY=replace-with-openrouter-api-key

# OpenRouter Embeddings & RAG
HERMES_EMBED_BASE_URL=https://openrouter.ai/api/v1
HERMES_EMBED_MODEL=openai/text-embedding-3-small
HERMES_EMBED_API_KEY=replace-with-openrouter-api-key
HERMES_EMBED_INPUT_TYPE=off
HERMES_RAG_MODE=soft
HERMES_MEMORY_INDEX=on

# MCP Server for Antigravity, Cursor, and hermes-gateway
HERMES_MCP_ENABLED=on
HERMES_MCP_ALLOWED_HOSTS=hermes-agent,api.hermes.sadramst.dev

# Optional decision/handoff integrations (kept off by default)
HERMES_JEV_MODE=off
HERMES_GROK_HANDOFF=off

# Container registry
GHCR_OWNER=sadramst
IMAGE_TAG=latest
CHROMA_IMAGE=chromadb/chroma:1.0.0
