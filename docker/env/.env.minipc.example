# Mini PC Home Brain host mounts & remote access settings (gitignored once copied to .env.minipc).
# Run `bash docker/scripts/setup-minipc.sh` or copy to `docker/env/.env.minipc` (`chmod 600`).

# Host directory containing all of your local coding/work project repositories.
# Mounted at `/workspace` inside both `hermes-agent` and `hermes-gateway`.
HERMES_HOST_PROJECTS_DIR=../workspace

# Host directory containing your personal Brain vault (Obsidian notes, markdown docs, specs, plans).
# Mounted read-only at `/knowledge` and indexed via `bash docker/scripts/sync-brain.sh`.
HERMES_HOST_KNOWLEDGE_DIR=../knowledge

# Multi-project workspace mode inside hermes-agent: off | ro | rw
HERMES_WORKSPACE_MODE=rw

# Optional comma-separated allowlist override for project commands (leave commented for built-in safe defaults):
# Default: git,pytest,python3,python,ruff,npm,node,ls,find,make,cat,head,tail,wc
# HERMES_WORKSPACE_ALLOWED_CMDS=git,pytest,python3,python,ruff,npm,node,ls,find,make,cat,head,tail,wc

# Optional public HTTPS access via Cloudflare Tunnel (no home router port-forwarding needed).
# Uncomment with your Cloudflare Zero Trust tunnel token, and add your tunnel domains to
# HERMES_MCP_ALLOWED_HOSTS inside `docker/env/.env.prod`:
# CLOUDFLARE_TUNNEL_TOKEN=
