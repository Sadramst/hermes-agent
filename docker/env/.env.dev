HERMES_API_TOKEN=
HERMES_MODEL_BASE_URL=
HERMES_MODEL_NAME=
HERMES_MODEL_SMALL=
HERMES_MODEL_API_KEY=
HERMES_JEV_MODE=off
HERMES_MCP_ENABLED=off
HERMES_MCP_ALLOWED_HOSTS=
HERMES_GROK_HANDOFF=off
HERMES_JEV_API_KEY=
HERMES_JEV_BASE_URL=
HERMES_JEV_MODEL=
GHCR_OWNER=local
IMAGE_TAG=dev
CHROMA_IMAGE=chromadb/chroma:1.0.0
