# Local development. Values here are templates. Keep real secrets in an untracked .env.local file.
HERMES_ENV=dev
HERMES_HOST=0.0.0.0
HERMES_PORT=8080
HERMES_LOG_LEVEL=DEBUG
HERMES_MEMORY_DIR=/app/storage/memory
HERMES_SKILLS_DIR=/app/storage/skills
HERMES_PROFILE_DIR=/app/gateway
HERMES_TIMEZONE=Asia/Singapore
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=
HERMES_API_TOKEN=
HERMES_PROVIDER_AUTH_MODE=openrouter
HERMES_MODEL_BASE_URL=
HERMES_MODEL_NAME=
HERMES_MODEL_API_KEY=
HERMES_MCP_ENABLED=off
HERMES_MCP_ALLOWED_HOSTS=
GHCR_OWNER=local
IMAGE_TAG=dev
CHROMA_IMAGE=chromadb/chroma:1.0.0
