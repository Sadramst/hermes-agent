# Test stack. Storage mounts are ephemeral tmpfs volumes in compose.
HERMES_ENV=test
HERMES_HOST=0.0.0.0
HERMES_PORT=8080
HERMES_LOG_LEVEL=INFO
HERMES_MEMORY_DIR=/app/storage/memory
HERMES_SKILLS_DIR=/app/storage/skills
HERMES_PROFILE_DIR=/tmp/hermes-test/gateway
HERMES_TIMEZONE=UTC
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=
HERMES_API_TOKEN=
HERMES_PROVIDER_AUTH_MODE=api_key
HERMES_MODEL_BASE_URL=
HERMES_MODEL_NAME=
HERMES_MODEL_API_KEY=
HERMES_MCP_ENABLED=off
HERMES_MCP_ALLOWED_HOSTS=
GHCR_OWNER=local
IMAGE_TAG=test
CHROMA_IMAGE=chromadb/chroma:1.0.0
